# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/naseeb"
DIRECT_URL="postgresql://user:password@localhost:5432/naseeb"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OneSignal Push Notifications
NEXT_PUBLIC_ONESIGNAL_APP_ID="your-onesignal-app-id"
NEXT_PUBLIC_ONESIGNAL_SAFARI_WEB_ID=""
ONESIGNAL_REST_API_KEY="your-onesignal-rest-api-key"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Broadnet SMS (OTP)
BROADNET_USER="your-broadnet-username"
BROADNET_PASS="your-broadnet-password"
BROADNET_SENDER_ID="naseebak"
BROADNET_API_URL="https://gwjo1s.broadnet.me:8443/websmpp/websms"

# SMTP (Hostinger) — admin notification on new registration
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="info@naseebak.com"
SMTP_PASS="your-mailbox-password"
SMTP_FROM="\"نصيبك Naseebak\" <info@naseebak.com>"
ADMIN_NOTIFY_EMAIL="you@example.com"

# Ably (real-time chat events; optional — without it the chat page polls)
ABLY_API_KEY=""

# Daily scheduler: GET/POST /api/cron/daily with "Authorization: Bearer $CRON_SECRET" (also guards
# /api/cron/process-deletions?token=). Set a long random value in production (openssl rand -hex 32);
# empty = the cron routes always answer 401.
CRON_SECRET=""

# Footer social links (optional; an empty value hides that icon)
NEXT_PUBLIC_SOCIAL_FACEBOOK=""
NEXT_PUBLIC_SOCIAL_X=""
NEXT_PUBLIC_SOCIAL_INSTAGRAM=""
NEXT_PUBLIC_SOCIAL_YOUTUBE=""

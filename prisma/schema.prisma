generator client {
  provider        = "prisma-client-js"
  output          = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum Gender {
  MALE
  FEMALE
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum SuggestionSource {
  AI
  ADMIN
}

/// LEGACY: recipient answers, then the other side gets an interest. MUTUAL: both decide on the same row.
enum SuggestionFlow {
  LEGACY
  MUTUAL
}

enum SuggestionDecision {
  INTERESTED
  DECLINED
}

/// What a person told us about a match after the family introduction
enum MatchOutcome {
  CONTINUING
  NOT_A_MATCH
  ENGAGED
}

enum VisitStatus {
  REQUESTED
  FAMILIES_CONTACTED
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentType {
  PACKAGE
  SUBSCRIPTION
  MATCH_CREDITS
}

enum PaymentProvider {
  EFAWATEERCOM
  PAYPAL
  STRIPE
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum NotificationType {
  SUGGESTION
  INTEREST
  MATCH
  VISIT_UPDATE
  IDENTITY
  PAYMENT
  SUBSCRIPTION
  SYSTEM
  SUPPORT
  INTRO_REQUEST
  CHAT
}

enum IntroRequestType {
  FAMILY
  CHAT
}

enum IntroRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

enum ConversationStatus {
  ACTIVE
  ENDED
  EXPIRED
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
}

enum TicketType {
  ISSUE
  SUGGESTION
  CHANGE_REQUEST
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ReportReason {
  FAKE_PROFILE
  INAPPROPRIATE_CONTENT
  HARASSMENT
  SPAM
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

enum FeedbackOutcome {
  PROCEEDED
  DECLINED
}

enum IntroPreference {
  CHAT
  FAMILY
}

enum CreditReason {
  REGISTRATION
  PURCHASE
  REQUEST
  SUGGESTION
  ADMIN_ADJUST
  MIGRATION_GIFT
  REFUND
  REFERRAL
  INTEREST
  /// Answering «سؤال نصيبك» (poll_reward_credits per question)
  POLL_REWARD
}

// ─── Models ─────────────────────────────────────────────────────────────────

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  phone             String?    @unique
  passwordHash      String?
  firstName         String
  lastName          String
  gender            Gender
  /// Country of the account (JO / SA), from the phone number at registration; members only meet
  /// people of their own country (multi-country 2026-10-26). Existing rows = JO.
  country           String     @default("JO")
  role              UserRole   @default(USER)
  status            UserStatus @default(PENDING)
  /// Status to restore on unsuspend (set while SUSPENDED)
  statusBeforeSuspension UserStatus?
  isVerified        Boolean    @default(false)
  isDeactivated     Boolean    @default(false)
  matchCredits      Int        @default(1)
  oneSignalPlayerId String?
  isFlagged         Boolean    @default(false)
  flagReason        String?
  referralCode      String?    @unique
  referredBy        String?
  verifiedAt        DateTime?
  /// Last time the user used the dashboard (updated at most once per hour; null = before this field existed)
  lastActiveAt      DateTime?
  /// Last "لديك ما ينتظرك" re-engagement push (daily scheduler, at most once per 7 days)
  reengagedAt       DateTime?
  /// Last SMS notice sent instead of a push (members without a push device): at most one per day
  lastSmsNoticeAt   DateTime?
  termsAcceptedAt   DateTime? // Terms + privacy + 18+ ticked at sign-up
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  profile           Profile?
  personalityResult PersonalityResult?
  parentInfo        ParentInfo?
  identityDoc       IdentityDoc?
  photos            Photo[]
  subscriptions     Subscription[]
  payments          Payment[]
  notifications     Notification[]

  // Suggestions where this user is the recipient (receives the suggestion)
  receivedSuggestions Suggestion[]     @relation("SuggestionRecipient")
  // Suggestions where this user is the candidate (suggested to someone)
  givenSuggestions    Suggestion[]     @relation("SuggestionCandidate")

  likesGiven        Like[]             @relation("LikeFrom")
  likesReceived     Like[]             @relation("LikeTo")

  matchesAsFemale   MutualMatch[]      @relation("MatchFemale")
  matchesAsMale     MutualMatch[]      @relation("MatchMale")

  // Identity docs reviewed by this admin
  reviewedDocs      IdentityDoc[]      @relation("ReviewedBy")

  profileUpdateRequests ProfileUpdateRequest[]

  reportsSubmitted  Report[]  @relation("ReportsSubmitted")
  reportsReceived   Report[]  @relation("ReportsReceived")
  blocksGiven       Block[]   @relation("BlocksGiven")
  blocksReceived    Block[]   @relation("BlocksReceived")
  deletionRequest   AccountDeletionRequest?
  supportTickets    SupportTicket[]

  visitFeedbacks          VisitFeedback[]
  notificationPreferences NotificationPreference?
  referralsGiven          Referral[]  @relation("ReferralsGiven")
  referralsReceived       Referral?   @relation("ReferralsReceived")

  sentIntroRequests     IntroRequest[] @relation("IntroSender")
  receivedIntroRequests IntroRequest[] @relation("IntroReceiver")
  messages              Message[]
  creditLedger          CreditLedger[]
  pollVotes             PollVote[]
  mobileSessions        MobileSession[]
  pushDevices           PushDevice[]

  @@index([country, gender])
  @@map("users")
}

model Profile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  dateOfBirth         DateTime?
  city                String?
  nationality         String?
  maritalStatus       String?   // single, divorced, widowed
  education           String?
  fieldOfStudy        String?
  job                 String?
  incomeRange         String?
  religiosity         String?
  familyValues        String?
  partnerExpectations String?
  hobbies             String?
  interests           String?
  lifestyle           String?
  height              Int?
  weight              Int?
  skinColor           String?
  childrenCount       Int       @default(0)
  willingToRelocate   String?
  hijab               Boolean?
  smokingStatus       String?
  aboutMe             String?

  area                String?
  latitude            Float?
  longitude           Float?
  tribe               String?
  familyOriginArea    String?
  numberOfSiblings    Int?
  housingType         String?
  beard               Boolean?
  cookingAbility      String?
  drivingLicense      Boolean?
  healthConditions    String?
  monthlyExpenses     String?
  wantsPhoto          Boolean?
  profileImageUrl     String?

  prefAgeMin          Int?
  prefAgeMax          Int?
  prefCity            String[]
  prefEducation       String[]
  prefMaritalStatus   String[]
  prefHijab               String?
  prefBeard               String?
  prefReligiosity         String[]
  prefSmokingStatus       String[]
  prefChildrenAcceptance  String?
  /// Preference keys the user marked as hard filters (DEALBREAKER_KEYS in src/lib/matching/score.ts)
  dealbreakers            String[] @default([])

  setupStep           Int      @default(1)
  isComplete          Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("profiles")
}

model PersonalityResult {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  answers         Json     // Raw quiz answers
  vector          Float[]  // Personality vector for cosine similarity
  personalityType String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("personality_results")
}

model ParentInfo {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  parentName      String
  parentPhone     String
  relationship    String   // father, mother, brother, guardian
  address         String?  // Home address for visit coordination
  notes           String?
  // Consent to share name/relationship/phone with the other family after an accepted family introduction
  shareConsentAt  DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("parent_info")
}

model IdentityDoc {
  id              String             @id @default(cuid())
  userId          String             @unique
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  frontImageUrl   String             // Selfie photo (legacy rows: front of government ID)
  backImageUrl    String?            // Legacy only: back of government ID (null for selfies)
  documentType    String             // "selfie" (legacy: national_id, passport)
  status          VerificationStatus @default(PENDING)
  rejectionReason String?
  reviewNotes     String?
  reviewedById    String?
  reviewedBy      User?              @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@map("identity_docs")
}

model Photo {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  url             String
  isPrimary       Boolean  @default(false)
  order           Int      @default(0)

  createdAt       DateTime @default(now())

  @@map("photos")
}

model Suggestion {
  id                 String           @id @default(cuid())
  recipientId        String           @map("femaleId")
  recipient          User             @relation("SuggestionRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  candidateId        String           @map("maleId")
  candidate          User             @relation("SuggestionCandidate", fields: [candidateId], references: [id], onDelete: Cascade)

  compatibilityScore Float
  status             SuggestionStatus @default(PENDING)
  source             SuggestionSource @default(AI)
  expiresAt          DateTime?

  // Simultaneous suggestions (switch `new_suggestions_flow`); legacy rows keep the defaults
  flow               SuggestionFlow      @default(LEGACY)
  recipientDecision  SuggestionDecision?
  recipientDecidedAt DateTime?
  candidateDecision  SuggestionDecision?
  candidateDecidedAt DateTime?
  /// Credit on interest: the «مهتم» credit given back because the other side never answered (set once)
  interestRefundedAt DateTime?
  /// "2 days left" reminder sent to the undecided side(s) (daily scheduler, once)
  reminderSentAt     DateTime?
  /// Chosen with "interested" when credit_on_interest is on (null otherwise)
  recipientIntroPreference IntroPreference?
  candidateIntroPreference IntroPreference?
  /// Made while the candidate already held 5 open cards: hidden from the candidate (and not taking a
  /// slot) until the recipient says «مهتم» or the candidate frees a slot (revealHiddenFor)
  hiddenFromCandidate      Boolean @default(false)

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([recipientId, candidateId])
  @@map("suggestions")
}

model Like {
  id              String   @id @default(cuid())
  fromUserId      String
  fromUser        User     @relation("LikeFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId        String
  toUser          User     @relation("LikeTo", fields: [toUserId], references: [id], onDelete: Cascade)

  suggestionId    String?
  isLiked         Boolean  @default(true)

  createdAt       DateTime @default(now())

  @@unique([fromUserId, toUserId])
  @@map("likes")
}

model MutualMatch {
  id              String       @id @default(cuid())
  femaleId        String
  female          User         @relation("MatchFemale", fields: [femaleId], references: [id], onDelete: Cascade)
  maleId          String
  male            User         @relation("MatchMale", fields: [maleId], references: [id], onDelete: Cascade)

  suggestionId       String?
  photosRevealed     Boolean      @default(true)
  revealedByFemale   Boolean      @default(false)

  visitRequest    VisitRequest?
  introRequests   IntroRequest[]
  conversation    Conversation?

  /// Set when the match opened straight into chat / family intro (credit_on_interest)
  openedAt              DateTime?
  /// Per-match consent to share each side's guardian contact (credit_on_interest)
  femaleGuardianShareAt DateTime?
  maleGuardianShareAt   DateTime?
  /// Mixed choice: the side that chose chat was reminded once to share its guardian contact
  guardianShareRemindedAt DateTime?
  /// How the introduction went, per side (null = not told us yet); see src/lib/intro/followup.ts
  femaleOutcome         MatchOutcome?
  maleOutcome           MatchOutcome?
  femaleOutcomeAt       DateTime?
  maleOutcomeAt         DateTime?
  /// "How is the family introduction going?" follow-ups sent (at most 3, 7 / 21 / 35 days)
  followUpCount         Int          @default(0)
  followUpSentAt        DateTime?

  createdAt       DateTime     @default(now())

  @@unique([femaleId, maleId])
  @@map("mutual_matches")
}

model VisitRequest {
  id              String      @id @default(cuid())
  matchId         String      @unique
  match           MutualMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  status          VisitStatus @default(REQUESTED)
  adminNotes      String?
  scheduledDate   DateTime?
  location        String?

  feedbacks       VisitFeedback[]

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("visit_requests")
}

model Payment {
  id              String        @id @default(cuid())
  /// Null once the account is deleted: payment records are kept
  userId          String?
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  type            PaymentType   @default(SUBSCRIPTION)
  planName        String?       // e.g. "basic", "premium", "suggestion_pack"
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("JOD")
  provider        PaymentProvider
  providerTxId    String?
  status          PaymentStatus @default(PENDING)
  description     String?
  /// Stripe Checkout session (cs_…) — set when the session is created; used to expire it on «رجوع»
  stripeSessionId String?
  /// A Stripe dispute (chargeback) was opened on this payment
  disputedAt      DateTime?

  subscription    Subscription?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([stripeSessionId])
  @@map("payments")
}

model Subscription {
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  paymentId       String?            @unique
  payment         Payment?           @relation(fields: [paymentId], references: [id])

  plan            String             // e.g. "basic", "premium"
  suggestionsLeft Int
  status          SubscriptionStatus @default(ACTIVE)
  autoRenew       Boolean            @default(false)
  startsAt        DateTime           @default(now())
  expiresAt       DateTime

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@map("subscriptions")
}

model Notification {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  type            NotificationType
  title           String
  body            String
  isRead          Boolean          @default(false)
  metadata        Json?

  createdAt       DateTime         @default(now())

  // The list / "once per day" checks and the unread badge every open tab polls
  @@index([userId, createdAt])
  @@index([userId, isRead])
  @@map("notifications")
}

model ProfileUpdateRequest {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  changes    Json      // { field: newValue, ... }
  message    String?   // User's reason for change
  status     String    @default("PENDING") // PENDING, APPROVED, REJECTED
  adminNote  String?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("profile_update_requests")
}

/// Fixed-window counters for rate limits that must survive restarts (OTP send/verify)
model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime

  @@index([resetAt])
  @@map("rate_limit_buckets")
}

model Otp {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone, code])
  @@map("otps")
}

model BlogCategory {
  id        String     @id @default(cuid())
  slug      String     @unique
  nameAr    String
  nameEn    String
  posts     BlogPost[]
  createdAt DateTime   @default(now())

  @@map("blog_categories")
}

model BlogPost {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  excerpt     String
  content     String         @db.Text
  status      BlogPostStatus @default(DRAFT)
  categoryId  String
  category    BlogCategory   @relation(fields: [categoryId], references: [id])
  authorId    String?
  readTime    String?
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
  @@map("blog_posts")
}

model Report {
  id          String       @id @default(cuid())
  /// Null once that account is deleted: the report and its evidence are kept (see `evidence`)
  reporterId  String?
  reporter    User?        @relation("ReportsSubmitted", fields: [reporterId], references: [id], onDelete: SetNull)
  reportedId  String?
  reported    User?        @relation("ReportsReceived", fields: [reportedId], references: [id], onDelete: SetNull)
  reason      ReportReason
  details     String?
  status      ReportStatus @default(PENDING)
  adminNote   String?
  reviewedAt  DateTime?
  // Set when the report was sent while ending a chat (new cycle); no FK so deleting a chat never touches reports
  conversationId String?
  reviewedById   String?
  /// Snapshot taken before an account in this report is deleted: both people (name, phone) and the
  /// chat between them, which would otherwise disappear with the match (src/lib/reports.ts)
  evidence       Json?
  createdAt   DateTime     @default(now())

  @@unique([reporterId, reportedId])
  @@map("reports")
}

model Block {
  id         String   @id @default(cuid())
  blockerId  String
  blocker    User     @relation("BlocksGiven", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId  String
  blocked    User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@map("blocks")
}

model AccountDeletionRequest {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason      String?
  scheduledAt DateTime
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())

  @@map("account_deletion_requests")
}

model SupportTicket {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        TicketType
  subject     String
  description String       @db.Text
  status      TicketStatus @default(OPEN)
  adminNote   String?      @db.Text
  resolvedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("support_tickets")
}

/// Public contact-page message (visitor or signed-in user); read in Admin → Messages
model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  /// Null when the sender left only a phone number
  email     String?
  /// Contact phone (962…), when given instead of / besides an email
  phone     String?
  subject   String
  message   String    @db.Text
  /// Set when the sender was signed in
  userId    String?
  /// Visitor's country when the message was sent (JO / SA; admin filters by it)
  country   String    @default("JO")
  handledAt DateTime?
  createdAt DateTime  @default(now())

  @@index([createdAt])
  @@map("contact_messages")
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("system_settings")
}

model VisitFeedback {
  id        String          @id @default(cuid())
  visitId   String
  visit     VisitRequest    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  outcome   FeedbackOutcome
  reason    String?
  rating    Int             // 1-5
  createdAt DateTime        @default(now())

  @@unique([visitId, userId])
  @@map("visit_feedbacks")
}

model NotificationPreference {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  suggestions  Boolean  @default(true)
  interests    Boolean  @default(true)
  matches      Boolean  @default(true)
  visitUpdates Boolean  @default(true)
  payments     Boolean  @default(true)
  identity     Boolean  @default(true)
  support      Boolean  @default(true)
  introRequests Boolean @default(true)
  chatMessages Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("notification_preferences")
}

model Referral {
  id             String    @id @default(cuid())
  referrerId     String
  referrer       User      @relation("ReferralsGiven", fields: [referrerId], references: [id], onDelete: Cascade)
  refereeId      String    @unique
  referee        User      @relation("ReferralsReceived", fields: [refereeId], references: [id], onDelete: Cascade)
  creditsAwarded Boolean   @default(false)
  awardedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@map("referrals")
}

// ─── New cycle: introductions and chat ─────────────────────────────────────

model IntroRequest {
  id          String             @id @default(cuid())
  matchId     String
  match       MutualMatch        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  type        IntroRequestType
  senderId    String
  sender      User               @relation("IntroSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId  String
  receiver    User               @relation("IntroReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  status      IntroRequestStatus @default(PENDING)
  expiresAt   DateTime
  respondedAt DateTime?
  /// "2 days left" reminder sent to the receiver (daily scheduler, once)
  reminderSentAt   DateTime?
  /// "انتهت مدة طلبك دون رد" sent to the sender (daily scheduler, once)
  expiryNotifiedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([matchId])
  @@index([receiverId, status])
  @@map("intro_requests")
}

model Conversation {
  id             String             @id @default(cuid())
  matchId        String             @unique
  match          MutualMatch        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  status         ConversationStatus @default(ACTIVE)
  expiresAt      DateTime
  extended       Boolean            @default(false)
  expiryWarnedAt DateTime?
  /// Day-7 "ready for a family introduction?" nudge sent (once)
  familyNudgeAt  DateTime?
  endedById      String?
  /// Set when an admin ended the chat (endedById stays null)
  endedByAdminId String?
  endedAt        DateTime?
  messages       Message[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  /// The sender app's id for this send: a retry after a lost answer gets the saved message back (chat/service.ts)
  clientNonce    String?
  readAt         DateTime?
  /// Unread-message SMS (lib/chat/unread-sms.ts): last attempt and its result (sent, sent_admin, has_push, already_today, opted_out, …)
  smsNoticeAt     DateTime?
  smsNoticeStatus String?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  // Not unique: a new unique constraint makes `prisma db push` stop for a data-loss prompt (the deploy runs it
  // without --accept-data-loss); simultaneous duplicates are caught in memory (single process)
  @@index([conversationId, senderId, clientNonce])
  @@index([readAt, createdAt])
  @@map("messages")
}

// ─── Credit history ─────────────────────────────────────────────────────────

/// One row per change to User.matchCredits (written by recordCredit in src/lib/credits.ts).
/// History starts with the release that added this table; earlier changes are not reconstructed.
model CreditLedger {
  id        String       @id @default(cuid())
  /// Null once the account is deleted: credit history is kept
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  delta     Int
  reason    CreditReason
  refId     String?      // payment / intro request / referral id
  adminId   String?
  note      String?
  createdAt DateTime     @default(now())

  @@index([userId, createdAt])
  @@index([reason, createdAt])
  @@map("credit_ledger")
}

/// One SMS per member per chat that hasn't started (lib/chat/unread-sms.ts): the latest attempt and its result.
model ChatSmsNotice {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  /// sent | sent_admin | has_push | already_today | opted_out | unknown_push | failed | skipped
  status         String
  at             DateTime
  /// Admin id for «Send SMS now»; null = the 15-minute job
  sentBy         String?

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@map("chat_sms_notices")
}

enum PollStatus {
  DRAFT
  ACTIVE
  CLOSED
}

/// «سؤال نصيبك» (switch engagement_polls_enabled): one question asked on Instagram, the public page /poll and
/// the dashboard home, a new one every poll_round_days (queued DRAFTs, oldest first). At most one ACTIVE poll at a time. Results show only from MIN_POLL_RESULTS votes.
model Poll {
  id        String     @id @default(cuid())
  /// URL name: /poll/<slug>
  slug      String     @unique
  question  String
  /// [{ id, label }], 2 to 4 options; ids never change once votes exist
  options   Json
  /// Short line shown after voting (optional)
  note      String?
  status    PollStatus @default(DRAFT)
  startedAt DateTime?
  /// When the scheduler swaps in the next queued question (startedAt + poll_round_days)
  endsAt    DateTime?
  closedAt  DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  votes     PollVote[]

  @@index([status])
  @@map("polls")
}

/// One vote per member (userId) or per visitor browser (visitorKey = sha256 of the visitor cookie)
model PollVote {
  id         String   @id @default(cuid())
  pollId     String
  poll       Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId   String
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  visitorKey String?
  /// Gender of a member when voting (women/men split); null for visitors
  gender     Gender?
  /// dashboard | page | instagram
  source     String   @default("page")
  /// Credits given to the member for this answer (0 for visitors or when the reward is off)
  rewardCredits Int   @default(0)
  createdAt  DateTime @default(now())

  @@unique([pollId, userId])
  @@unique([pollId, visitorKey])
  @@index([pollId, optionId])
  @@map("poll_votes")
}

enum SmsProviderKind {
  /// The country's usual provider: Jordan → Broadnet, Saudi Arabia → Unifonic
  DEFAULT
  BROADNET
  UNIFONIC
  /// Development only: never sends, keeps the message in a local outbox (refused in production)
  MOCK
  /// No SMS for this country (sign-up codes fail with 502)
  NONE
}

/// Admin-editable settings of a country (multi-country 2026-10-29). Fixed facts (dial code, phone rules, currency,
/// time zone) stay in code (src/lib/countries); a missing row means the code defaults (src/lib/countries/settings.ts):
/// Jordan active and selling, every other country inactive with purchases off — so a deploy never opens a country.
/// Provider secrets are never stored here (env only).
model CountrySetting {
  /// ISO 3166-1 alpha-2 (JO, SA)
  code             String          @id
  active           Boolean         @default(false)
  registrationOpen Boolean         @default(true)
  purchasesEnabled Boolean         @default(false)
  smsProvider      SmsProviderKind @default(DEFAULT)
  /// Overrides the provider's env sender id when set
  smsSenderId      String?
  supportEmail     String?
  supportPhone     String?
  supportWhatsapp  String?
  /// Public page overrides (empty = the built-in copy)
  seoTitle         String?
  seoDescription   String?
  heroTitle        String?
  heroSubtitle     String?
  /// «سؤال نصيبك» for members of this country
  pollsEnabled     Boolean         @default(true)
  updatedById      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@map("country_settings")
}

/// Sign-in of the mobile app (Bearer token). Only a SHA-256 of the token is stored; revoked on logout or by the
/// member's other sessions being cleared. Web sign-in keeps the NextAuth cookie.
model MobileSession {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  /// e.g. "android 15 · Pixel 8" (sent by the app, shown to the member/admin)
  device     String?
  expiresAt  DateTime
  lastUsedAt DateTime?
  revokedAt   DateTime?
  createdAt   DateTime     @default(now())
  pushDevices PushDevice[]

  @@index([userId])
  @@map("mobile_sessions")
}

/// FCM target (FID) of the mobile app (src/lib/fcm.ts). Tied to the app sign-in that registered it: pushes go only to
/// devices whose session is still valid, so logout / revoke stops them at once. The website stays on OneSignal.
model PushDevice {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  mobileSessionId String
  mobileSession   MobileSession @relation(fields: [mobileSessionId], references: [id], onDelete: Cascade)
  /// Firebase Installation ID (FCM direct-send target; one row per FID, moves to whichever sign-in registers it)
  fid             String        @unique
  /// "android" | "ios"
  platform        String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@map("push_devices")
}
